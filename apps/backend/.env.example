# PostgreSQL connection string. Local Postgres is provided by the Supabase CLI (see
# apps/backend/supabase/config.toml) - run `npm run supabase:start` from the repo root
# (or `supabase start --workdir apps/backend`) to bring it up. Port 54432 matches that
# config, not the Supabase CLI's own default (54322), which is already in use elsewhere
# on this machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:54432/postgres

# HTTP port for the Geko backend API (default: 4000)
PORT=4000

# JWT signing secrets (generate strong random values for non-local use)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# JWT token lifetimes (used in a later auth phase)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Mobile app origin/scheme for CORS (Expo dev server example)
MOBILE_APP_ORIGIN=http://localhost:8081

# Cavos App ID from the Cavos dashboard (required)
CAVOS_APP_ID=your-cavos-app-id

# App salt used for deterministic wallet derivation (default: geko-mobile)
CAVOS_APP_SALT=geko-mobile

# Stellar network: testnet | mainnet (default: testnet)
CAVOS_NETWORK=testnet

# AES-256-GCM key for wallet secrets (base64-encoded 32 bytes). Generate with:
#   openssl rand -base64 32
WALLET_SECRETS_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Abroad Finance API key (server-to-server, X-API-Key header). Optional - cross-border
# payments are gracefully disabled until this is set. Request from support@abroad.finance.
ABROAD_API_KEY=

# Shared secret Abroad sends back in the X-Abroad-Webhook-Secret header on every webhook
# call. Optional - the webhook endpoint rejects everything (fail closed) until this is set.
ABROAD_WEBHOOK_SECRET=

# Abroad's own Stellar deposit address (G...) that clients send funds to for cross-border
# off-ramp. Not published in Abroad's docs - request it alongside the API key.
ABROAD_STELLAR_DEPOSIT_ADDRESS=
