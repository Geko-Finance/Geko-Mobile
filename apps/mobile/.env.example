# Geko NestJS backend API base URL (default: http://localhost:4000)
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000

# Cavos App ID from the Cavos dashboard (optional; can also be set in app.json extra)
EXPO_PUBLIC_CAVOS_APP_ID=

# Stellar network the app talks to (default: testnet - see app.json's extra.stellarNetwork,
# which is the actual default source; this only overrides it for a local run).
EXPO_PUBLIC_STELLAR_NETWORK=

# Soroban RPC endpoints for Stellar testnet/mainnet - optional, both already default
# to the public Soroban RPC URLs (see src/config/env.ts); the mainnet endpoint is a
# shared/rate-limited public provider, so set these to swap in a dedicated RPC
# provider before real mainnet traffic without a code change.
EXPO_PUBLIC_STELLAR_TESTNET_RPC_URL=
EXPO_PUBLIC_STELLAR_MAINNET_RPC_URL=

# Circle's USDC issuer (G...) on Stellar testnet/mainnet - optional, both already
# default to Circle's official issuers (see src/config/env.ts); only set these if
# Circle ever rotates an issuer.
EXPO_PUBLIC_CCTP_USDC_ISSUER_TESTNET=
EXPO_PUBLIC_CCTP_USDC_ISSUER_MAINNET=
